{
  "name": "agentcore-provision",
  "version": "1.0.0",
  "private": true,
  "description": "Scripted provisioning for the AgentCore Runtime PoC (ECR repo + shared execution role + runtime create/update). Baseline for the future dynamic agent-manager. Not Terraform.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "cd ../.. && node_modules/.bin/eslint archie-runner/agentcore-provision",
    "ensure": "tsx provision.ts ensure",
    "deploy": "tsx provision.ts deploy"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1089.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-ecr": "^3.700.0",
    "@aws-sdk/client-ecs": "^3.1089.0",
    "@aws-sdk/client-efs": "^3.1089.0",
    "@aws-sdk/client-iam": "^3.700.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}

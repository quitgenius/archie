{
  "name": "slack-dispatcher",
  "version": "1.0.0",
  "private": true,
  "description": "Clawdbot Slack dispatcher — owns the Slack tokens, fans incoming Socket Mode events out to per-agent containers, and proxies outbound Slack API calls so agents never see the tokens.",
  "main": "index.js",
  "scripts": {
    "lint": "cd .. && node_modules/.bin/eslint archie-gateway",
    "start": "node index.js",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@aws-sdk/client-ecr": "^3.1107.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock": "^3",
    "@aws-sdk/client-bedrock-agentcore": "^3",
    "@aws-sdk/client-bedrock-agentcore-control": "^3",
    "@aws-sdk/client-bedrock-runtime": "^3",
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/client-ecs": "^3",
    "@aws-sdk/client-efs": "^3",
    "@aws-sdk/client-iam": "^3",
    "@aws-sdk/client-sqs": "^3.1107.0",
    "@aws-sdk/credential-provider-node": "^3.972.76",
    "@aws-sdk/lib-dynamodb": "^3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.76.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "@smithy/node-http-handler": "^4.9.13",
    "@smithy/protocol-http": "^5.5.16",
    "@smithy/signature-v4": "^5.6.12",
    "async-mutex": "^0.5.0",
    "croner": "^9.1.0",
    "express": "^4.21.0",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "@aws-sdk/client-secrets-manager": "^3"
  },
  "engines": {
    "node": ">=20"
  }
}
